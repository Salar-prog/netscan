# NetScan configuration example.
# Copy to .env and adjust. Every variable is optional; defaults shown.

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=true
# REQUIRED in production (DEBUG=false). Used for session signing:
SECRET_KEY=
# Separate secret for dashboard session cookies (falls back to SECRET_KEY):
SESSION_SECRET_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./netscan.db

# ── Scanner defaults ────────────────────────────────────────────────────────
DEFAULT_SCAN_INTERVAL_MINUTES=60
DEFAULT_MISS_THRESHOLD=3
DEFAULT_QUARANTINE_HOURS=48
NMAP_TIMEOUT_SECONDS=300

# ── Network / security ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=
TRUSTED_PROXIES=
RATE_LIMIT_DEFAULT=120/minute

# ── Webhooks ────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_FORMAT=text   # text | json
LOG_LEVEL=INFO

# ── LDAP / Active Directory (optional) ─────────────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://dc01.corp.local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SEARCH_FILTER=(member={user_dn})
LDAP_START_TLS=false
LDAP_CA_CERT_FILE=

# ── Bootstrap / retention ─────────────────────────────────────────────────
DISABLE_BOOTSTRAP=false
RETENTION_DAYS=90
